diff --git a/src/isa/riscv64/instr/rvv/vcompute.h b/src/isa/riscv64/instr/rvv/vcompute.h
index 2bcb6aae..1a762d75 100644
--- a/src/isa/riscv64/instr/rvv/vcompute.h
+++ b/src/isa/riscv64/instr/rvv/vcompute.h
@@ -19,6 +19,35 @@
 #include "vcompute_impl.h"
 #include "vcommon.h"
 
+
+// CIE convention: eight low int8 pairs, int32 result, zero upper 96 bits.
+// Read all sources before writing, so vd may alias either source (or v0).
+// Custom: vdot illegal config exception reports mtval=0 (matches RTL behavior)
+extern int vdot_illegal_no_tval;
+
+def_EHelper(vdot) {
+  require_vector(true);
+  fprintf(stderr, "[vdot-ref] vl=%llu vstart=%llu vm=%u vsew=%u vlmul=%u\n", (unsigned long long)vl->val, (unsigned long long)vstart->val, (unsigned)s->vm, (unsigned)vtype->vsew, (unsigned)vtype->vlmul);
+  if (vtype->vsew != 0 || vtype->vlmul != 0 || vl->val != 8 ||
+      vstart->val != 0 || s->vm != 1) {
+    fprintf(stderr, "[vdot-ref] THROW EX_II=%d\n", EX_II);
+    vdot_illegal_no_tval = 1;
+    longjmp_exception(EX_II);
+  }
+  int32_t sum = 0;
+  for (int i = 0; i < 8; i++) {
+    int32_t a = vreg_b(id_src->reg, i);
+    int32_t b = vreg_b(id_src2->reg, i);
+    if (a >= 128) a -= 256;
+    if (b >= 128) b -= 256;
+    sum += a * b;
+  }
+  set_vreg(id_dest->reg, 0, (uint32_t)sum, 3, 0, 0);
+  set_vreg(id_dest->reg, 1, 0, 3, 0, 0);
+  vstart->val = 0;
+  vp_set_dirty();
+}
+
 def_EHelper(vadd) {
   ARITH(ADD, SIGNED)
 }
